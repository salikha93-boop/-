.hero:before,.hero:after{content:"";position:absolute;border-radius:50%;background:rgba(255,255,255,.08)}.hero:before{width:280px;height:280px;right:-80px;top:-120px}.hero:after{width:180px;height:180px;right:160px;bottom:-120px}
