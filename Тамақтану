const grid=document.getElementById('grid'),search=document.getElementById('search'),empty=document.getElementById('empty'),resultCount=document.getElementById('resultCount');
function escapeHtml(v){return String(v).replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));}
function render(){const q=search.value.trim().toLocaleLowerCase('kk-KZ');const filtered=products.filter(p=>{const zoneOk=activeZone==='all'||p.zone===activeZone;const hay=[p.name,p.why,p.effect,p.advice,zoneMeta[p.zone].title].join(' ').toLocaleLowerCase('kk-KZ');return zoneOk&&(!q||hay.includes(q));});grid.innerHTML=filtered.map(p=>`<article class="card"><div class="card-head"><div class="icon" aria-hidden="true">${escapeHtml(p.icon)}</div><div><div class="name">${escapeHtml(p.name)}</div><span class="badge ${p.zone}">${zoneMeta[p.zone].emoji} ${zoneMeta[p.zone].title}</span></div></div><div class="fact"><div class="label">Неге осы аймақ?</div><p>${escapeHtml(p.why)}</p></div><div class="fact"><div class="label">Қысқаша әсері</div><p>${escapeHtml(p.effect)}</p></div><div class="advice">💡 Кеңес: ${escapeHtml(p.advice)}</div></article>`).join('');empty.style.display=filtered.length?'none':'block';resultCount.textContent=`${filtered.length} өнім көрсетілді`;}
document.querySelectorAll('.filter').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.filter').forEach(b=>b.classList.remove('active'));btn.classList.add('active');activeZone=btn.dataset.zone;render();}));search.addEventListener('input',render);document.getElementById('greenCount').textContent=products.filter(p=>p.zone==='green').length;document.getElementById('yellowCount').textContent=products.filter(p=>p.zone==='yellow').length;document.getElementById('redCount').textContent=products.filter(p=>p.zone==='red').length;render();
</script>
</body></html>
